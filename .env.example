# =============================================================================
# Coop Seasonal Sales — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Lines starting with # are comments.

# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Application Security (required) ───────────────────────────────────────────
# Admin login passcode — minimum 8 characters in production
ADMIN_PASSCODE=your-admin-passcode
# HMAC secret for session tokens — minimum 32 characters in production
APP_SECRET=your-32-char-app-secret-here

# ── Direct Database Connection (optional) ─────────────────────────────────────
# Used by some admin endpoints for faster direct queries (bypasses PostgREST).
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# SUPABASE_DB_URL=

# ── Site URL (optional) ───────────────────────────────────────────────────────
# Used for password-reset redirects. Falls back to request origin if unset.
# NEXT_PUBLIC_SITE_URL=https://coopseasonalsales.vercel.app

# ── SMTP / Contact Form (optional) ───────────────────────────────────────────
# Only needed if you use the /contact route to send emails via nodemailer.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=your-email@example.com
# SMTP_SECURE=true
# CONTACT_TO_EMAIL=recipient@example.com
